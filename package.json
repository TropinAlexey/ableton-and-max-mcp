{
  "name": "ableton-and-max-mcp",
  "version": "0.1.0",
  "description": "MCP server for Ableton Live + Max for Live",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "test:local": "tsc && DEBUG=true node dist/test-local.js",
    "test:local:watch": "tsc --watch & DEBUG=true node dist/test-local.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "osc": "^2.4.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
